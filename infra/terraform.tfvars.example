# FCT-Canada CU POC — example values for infra/deploy.tf
# Copy to terraform.tfvars (or pass with -var-file=terraform.tfvars).

# Azure subscription + tenant (replace with your own)
subscription_id = "00000000-0000-0000-0000-000000000000"
tenant_id       = "00000000-0000-0000-0000-000000000000"

# Naming prefix (drives all resource names)
prefix = "fcttest"

# Resource group
resource_group_name     = "fcttest-cu-rg"
resource_group_location = "canadacentral"

# Regions
cu_location     = "canadacentral"
models_location = "canadaeast"

# SKU
sku = "S0"

# Throughput capacities (1K TPM units)
gpt41_capacity            = 100
gpt41_mini_capacity       = 100
gpt4o_capacity            = 50
embedding_ada_capacity    = 50
embedding_3large_capacity = 50
embedding_3small_capacity = 50

# Governance tags
tags = {
  environment = "dev"
  owner       = "hschaefer"
  project     = "content-understanding"
  customer    = "fct-canada"
}
